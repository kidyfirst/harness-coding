{
  "packages/cli/src/**/*.ts": [
    "pnpm --filter @kidyfirst/harness-spec exec eslint --fix",
    "pnpm --filter @kidyfirst/harness-spec exec prettier --write"
  ],
  "packages/cli/test/**/*.ts": [
    "pnpm --filter @kidyfirst/harness-spec exec eslint --fix",
    "pnpm --filter @kidyfirst/harness-spec exec prettier --write"
  ]
}
